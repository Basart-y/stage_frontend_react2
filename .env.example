# Base de données (si absent, les repositories utilisent la mémoire pour le développement)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=relayflow

# Authentification
JWT_SECRET=relayflow-secret-de-test-2026-super-long

# Automatisations / cron
CRON_SECRET=change-me

# Finance - valeurs de référence configurables
MERCHANT_MONTHLY_PRICE=19.90
RELAY_PICKUP_UNIT_PRICE=1.50

# Coût bcrypt (10 à 14, 12 par défaut)
BCRYPT_ROUNDS=12

# Envoi des invitations par email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=" <no-reply@example.com>"

# Livraison
PICKUP_DEADLINE_DAYS=7

# WebSocket / automatisation interne (custom server.js)
ENABLE_INTERNAL_SCHEDULER=false
AUTOMATION_INTERVAL_MS=3600000

# Web Push / VAPID
# Génération : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
